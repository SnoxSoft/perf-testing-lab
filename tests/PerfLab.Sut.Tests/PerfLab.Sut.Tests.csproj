<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>PerfLab.Sut.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <!--
      xunit.v3 runs on Microsoft.Testing.Platform, so this test project is a
      self-executing console application rather than a library loaded by an
      external runner. It needs no VSTest adapter and no Microsoft.NET.Test.Sdk.

      The `dotnet test` opt-in lives in global.json at the repository root.
      TestingPlatformDotnetTestSupport is deliberately absent: that property
      belongs to the legacy VSTest mode, which the .NET 10 SDK no longer
      supports for MTP projects.
    -->
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.11" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.14.0" />
    <PackageReference Include="xunit.v3" Version="4.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/PerfLab.Sut/PerfLab.Sut.csproj" />
  </ItemGroup>

</Project>
